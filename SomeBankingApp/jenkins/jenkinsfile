pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/fabiocancilleri/SSS2026.git'
            }
        }
        stage('Build Backend') {
            steps {
                sh 'docker build -t my-backend:latest ./Backend'
            }
        }
        stage('Build Frontend') {
            steps {
                sh 'docker build -t my-frontend:latest ./Frontend'
            }
        }
       
    }
}